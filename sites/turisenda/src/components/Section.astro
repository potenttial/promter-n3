---
import Base from '../layouts/Base.astro';
import Card from './Card.astro';
import { SITE, catName, paths } from '../data/site.js';
import { articles } from '../data/content.js';
const { lang, cat } = Astro.props;
const list = (await articles(lang)).filter((a) => a.data.category === cat);
const name = catName(cat, lang);
---
<Base lang={lang} title={`${name} · ${SITE.name}`} description={`${name} — ${SITE.description[lang]}`} alt={paths.section(lang === 'es' ? 'en' : 'es', cat)}>
  <h1 style="margin-top:32px">{name}</h1>
  <section class="grid">{list.length ? list.map((a) => <Card a={a} lang={lang} />) : <p class="mute">{lang === 'es' ? 'Muy pronto.' : 'Coming soon.'}</p>}</section>
</Base>
